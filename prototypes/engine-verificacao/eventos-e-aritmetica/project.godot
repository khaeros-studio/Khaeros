; Protótipo descartável (EX-0002-1..3, EX-0009-1, EX-0010-1).
config_version=5

[application]
config/name="EX-0002 eventos e aritmetica"
run/main_scene="res://latencia.tscn"

[display]
window/size/viewport_width=640
